{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openFDA API Schema",
  "description": "Schema for openFDA Drug Adverse Events and Drugs@FDA API endpoints",
  "type": "object",
  "properties": {
    "endpoints": {
      "type": "object",
      "properties": {
        "drugAdverseEvents": {
          "type": "string",
          "description": "Drug Adverse Events endpoint",
          "default": "https://api.fda.gov/drug/event.json"
        },
        "drugsFda": {
          "type": "string",
          "description": "Drugs@FDA endpoint",
          "default": "https://api.fda.gov/drug/drugsfda.json"
        },
        "drugLabeling": {
          "type": "string",
          "description": "Drug Labeling endpoint",
          "default": "https://api.fda.gov/drug/label.json"
        },
        "drugNdc": {
          "type": "string",
          "description": "Drug NDC Directory endpoint",
          "default": "https://api.fda.gov/drug/ndc.json"
        },
        "drugEnforcement": {
          "type": "string",
          "description": "Drug Recall Enforcement endpoint",
          "default": "https://api.fda.gov/drug/enforcement.json"
        }
      }
    },
    "queryParameters": {
      "type": "object",
      "description": "Common query parameters for all openFDA endpoints",
      "properties": {
        "search": {
          "type": "string",
          "description": "Search query with field:term syntax. Supports AND/OR operators, exact phrases, and date ranges."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1,
          "description": "Number of records to return"
        },
        "skip": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25000,
          "default": 0,
          "description": "Number of records to skip for pagination"
        },
        "sort": {
          "type": "string",
          "description": "Sort results by field with :asc or :desc modifier"
        },
        "count": {
          "type": "string",
          "description": "Count unique values of a field instead of returning records. Use .exact suffix for full phrase counting."
        },
        "api_key": {
          "type": "string",
          "description": "Optional API key for higher rate limits"
        }
      }
    },
    "responseSchema": {
      "type": "object",
      "description": "Common response wrapper for all endpoints",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "disclaimer": {"type": "string"},
            "terms": {"type": "string"},
            "license": {"type": "string"},
            "last_updated": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Last data update date (YYYY-MM-DD)"
            },
            "results": {
              "type": "object",
              "properties": {
                "skip": {"type": "integer"},
                "limit": {"type": "integer"},
                "total": {"type": "integer"}
              },
              "required": ["skip", "limit", "total"]
            }
          }
        },
        "results": {
          "type": "array",
          "description": "Array of result objects (structure depends on endpoint)"
        }
      },
      "required": ["meta", "results"]
    }
  },
  "definitions": {
    "AdverseEventReport": {
      "type": "object",
      "description": "A single adverse event report from FAERS",
      "properties": {
        "safetyreportversion": {"type": "string"},
        "safetyreportid": {
          "type": "string",
          "description": "Unique report identifier (e.g., 6176304-1)"
        },
        "primarysourcecountry": {
          "type": "string",
          "description": "ISO 2-letter country code"
        },
        "occurcountry": {
          "type": "string",
          "description": "Country where event occurred"
        },
        "transmissiondate": {
          "type": "string",
          "pattern": "^\\d{8}$",
          "description": "Date in YYYYMMDD format"
        },
        "reporttype": {
          "type": "string",
          "enum": ["1", "2", "3", "4"],
          "description": "1=Expedited, 2=Periodic, 3=Periodic (delayed), 4=IND Safety Report"
        },
        "serious": {
          "type": "string",
          "enum": ["1", "2"],
          "description": "1=Serious, 2=Not serious"
        },
        "seriousnessdeath": {"type": "string", "description": "1 if death reported"},
        "seriousnesshospitalization": {"type": "string", "description": "1 if hospitalization"},
        "seriousnesslifethreatening": {"type": "string", "description": "1 if life threatening"},
        "seriousnessdisabling": {"type": "string", "description": "1 if disabling"},
        "seriousnesscongenitalanomali": {"type": "string", "description": "1 if congenital anomaly"},
        "seriousnessother": {"type": "string", "description": "1 if other serious outcome"},
        "receivedate": {
          "type": "string",
          "pattern": "^\\d{8}$",
          "description": "Date FDA received the report (YYYYMMDD)"
        },
        "receiptdate": {
          "type": "string",
          "pattern": "^\\d{8}$",
          "description": "Date of most recent information (YYYYMMDD)"
        },
        "companynumb": {"type": "string"},
        "primarysource": {
          "type": "object",
          "properties": {
            "reportercountry": {"type": "string"},
            "qualification": {
              "type": "string",
              "enum": ["1", "2", "3", "4", "5"],
              "description": "1=Physician, 2=Pharmacist, 3=Other health professional, 4=Lawyer, 5=Consumer"
            }
          }
        },
        "sender": {
          "type": "object",
          "properties": {
            "sendertype": {"type": "string"},
            "senderorganization": {"type": "string"}
          }
        },
        "receiver": {
          "type": "object",
          "properties": {
            "receivertype": {"type": "string"},
            "receiverorganization": {"type": "string"}
          }
        },
        "patient": {
          "$ref": "#/definitions/Patient"
        }
      },
      "required": ["safetyreportid", "receivedate", "patient"]
    },
    "Patient": {
      "type": "object",
      "properties": {
        "patientsex": {
          "type": "string",
          "enum": ["0", "1", "2"],
          "description": "0=Unknown, 1=Male, 2=Female"
        },
        "patientonsetage": {
          "type": "string",
          "description": "Age at onset (numeric string)"
        },
        "patientonsetageunit": {
          "type": "string",
          "enum": ["800", "801", "802", "803", "804", "805"],
          "description": "800=Decade, 801=Year, 802=Month, 803=Week, 804=Day, 805=Hour"
        },
        "patientweight": {
          "type": "string",
          "description": "Weight in kg"
        },
        "reaction": {
          "type": "array",
          "items": {"$ref": "#/definitions/Reaction"}
        },
        "drug": {
          "type": "array",
          "items": {"$ref": "#/definitions/Drug"}
        }
      }
    },
    "Reaction": {
      "type": "object",
      "properties": {
        "reactionmeddraversionpt": {"type": "string"},
        "reactionmeddrapt": {
          "type": "string",
          "description": "MedDRA Preferred Term for the reaction"
        },
        "reactionoutcome": {
          "type": "string",
          "enum": ["1", "2", "3", "4", "5", "6"],
          "description": "1=Recovered, 2=Recovering, 3=Not recovered, 4=Recovered with sequelae, 5=Fatal, 6=Unknown"
        }
      }
    },
    "Drug": {
      "type": "object",
      "properties": {
        "drugcharacterization": {
          "type": "string",
          "enum": ["1", "2", "3"],
          "description": "1=Suspect, 2=Concomitant, 3=Interacting"
        },
        "medicinalproduct": {
          "type": "string",
          "description": "Drug name as reported"
        },
        "drugauthorizationnumb": {"type": "string"},
        "drugdosagetext": {"type": "string"},
        "drugdosageform": {"type": "string"},
        "drugindication": {"type": "string"},
        "drugadministrationroute": {"type": "string"},
        "actiondrug": {
          "type": "string",
          "enum": ["1", "2", "3", "4", "5", "6"],
          "description": "1=Withdrawn, 2=Dose reduced, 3=Dose increased, 4=Dose not changed, 5=Unknown, 6=Not applicable"
        },
        "openfda": {
          "$ref": "#/definitions/OpenFDA"
        }
      }
    },
    "OpenFDA": {
      "type": "object",
      "description": "Harmonized fields added by openFDA to link records across datasets",
      "properties": {
        "application_number": {
          "type": "array",
          "items": {"type": "string"},
          "description": "NDA/ANDA numbers"
        },
        "brand_name": {
          "type": "array",
          "items": {"type": "string"}
        },
        "generic_name": {
          "type": "array",
          "items": {"type": "string"}
        },
        "manufacturer_name": {
          "type": "array",
          "items": {"type": "string"}
        },
        "product_ndc": {
          "type": "array",
          "items": {"type": "string"}
        },
        "product_type": {
          "type": "array",
          "items": {"type": "string"}
        },
        "route": {
          "type": "array",
          "items": {"type": "string"}
        },
        "substance_name": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rxcui": {
          "type": "array",
          "items": {"type": "string"},
          "description": "RxNorm concept identifiers"
        },
        "spl_id": {
          "type": "array",
          "items": {"type": "string"}
        },
        "spl_set_id": {
          "type": "array",
          "items": {"type": "string"}
        },
        "package_ndc": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unii": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Unique Ingredient Identifiers"
        },
        "pharm_class_epc": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Established Pharmacologic Class"
        },
        "pharm_class_moa": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Mechanism of Action"
        },
        "pharm_class_cs": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Chemical Structure"
        },
        "pharm_class_pe": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Physiologic Effect"
        }
      }
    },
    "DrugsFDARecord": {
      "type": "object",
      "description": "A single Drugs@FDA record for an approved drug product",
      "properties": {
        "application_number": {
          "type": "string",
          "description": "NDA or ANDA number (e.g., NDA021457)"
        },
        "sponsor_name": {
          "type": "string",
          "description": "Drug sponsor/company name"
        },
        "openfda": {
          "$ref": "#/definitions/OpenFDA"
        },
        "products": {
          "type": "array",
          "items": {"$ref": "#/definitions/Product"}
        },
        "submissions": {
          "type": "array",
          "items": {"$ref": "#/definitions/Submission"}
        }
      },
      "required": ["application_number"]
    },
    "Product": {
      "type": "object",
      "properties": {
        "product_number": {"type": "string"},
        "reference_drug": {
          "type": "string",
          "enum": ["Yes", "No"]
        },
        "brand_name": {"type": "string"},
        "active_ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "strength": {"type": "string"}
            },
            "required": ["name", "strength"]
          }
        },
        "reference_standard": {
          "type": "string",
          "enum": ["Yes", "No"]
        },
        "dosage_form": {
          "type": "string",
          "description": "e.g., TABLET, CAPSULE, INJECTION, SOLUTION"
        },
        "route": {
          "type": "string",
          "description": "e.g., ORAL, INTRAVENOUS, TOPICAL"
        },
        "marketing_status": {
          "type": "string",
          "enum": ["Prescription", "Over-the-counter", "Discontinued", "None"],
          "description": "Current marketing status"
        }
      }
    },
    "Submission": {
      "type": "object",
      "properties": {
        "submission_type": {
          "type": "string",
          "enum": ["ORIG", "SUPPL"],
          "description": "ORIG=Original, SUPPL=Supplement"
        },
        "submission_number": {"type": "string"},
        "submission_status": {
          "type": "string",
          "description": "AP=Approved, TA=Tentatively Approved"
        },
        "submission_status_date": {
          "type": "string",
          "pattern": "^\\d{8}$",
          "description": "Date in YYYYMMDD format"
        },
        "review_priority": {
          "type": "string",
          "enum": ["STANDARD", "PRIORITY", "ORPHAN"]
        },
        "submission_class_code": {"type": "string"},
        "submission_class_code_description": {"type": "string"},
        "application_docs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "url": {"type": "string"},
              "date": {"type": "string"},
              "type": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
